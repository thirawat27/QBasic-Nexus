{
    "name": "qbasic-nexus",
    "displayName": "QBasic Nexus",
    "description": "The Most Advanced, Lightning-Fast QBasic & QB64 Development Environment Ever Built for VS Code 🚀.",
    "version": "2.0.0",
    "publisher": "Thirawat27",
    "author": "Thirawat27",
    "license": "MIT",
    "icon": "assets/QBasicNexus.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/thirawat27/QBasic-Nexus"
    },
    "bugs": {
        "url": "https://github.com/thirawat27/QBasic-Nexus/issues"
    },
    "homepage": "https://github.com/thirawat27/QBasic-Nexus#readme",
    "engines": {
        "node": ">=22.0.0",
        "vscode": "^1.125.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:qbasic",
        "onView:qbasic-todo",
        "onDebugResolve:qb64",
        "onDebugDynamicConfigurations:qb64",
        "onTaskType:qb64",
        "workspaceContains:**/*.bas"
    ],
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "pretest": "npm run lint",
        "test": "npm run test:compiler && npm run test:run && npm run test:variables && npm run test:features && npm run test:integration && npm run test:deep && npm run test:autodetect && npm run test:qb64diagnostics && npm run test:qb64pe && npm run test:languagefeatures && npm run test:debugger && npm run test:workspace && npm run test:webview && npm run test:tutorial && npm run test:todo && npm run test:optimizations && npm run test:executables && npm run test:workersettings && npm run test:systemsettings && npm run test:hotpath && npm run test:configcache && npm run test:cacheintegrity && npm run test:processtimeout",
        "benchmark": "npm run benchmark:compiler && npm run benchmark:editor",
        "benchmark:compiler": "node test/benchmark-compiler.js",
        "benchmark:editor": "node test/benchmark-editor.js",
        "test:compiler": "node test/test-transpiler.js",
        "test:run": "node test/test-compile-and-run.js",
        "test:variables": "node test/test-variable-declaration.js",
        "test:features": "node test/test-editor-features.js",
        "test:integration": "node test/test-integration.js",
        "test:deep": "node test/test-deep.js",
        "test:autodetect": "node test/test-qb64-autodetect.js",
        "test:qb64diagnostics": "node test/test-qb64-compiler.js",
        "test:workspace": "node test/test-workspace-multi.js",
        "test:webview": "node test/test-webview-manager.js",
        "test:todo": "node test/test-todo-provider.js",
        "test:tutorial": "node test/test-tutorial-manager.js",
        "test:optimizations": "node test/test-optimization-managers.js",
        "test:executables": "node test/test-executable-utils.js",
        "test:systemsettings": "node test/test-system-settings.js",
        "test:hotpath": "node test/test-hot-path-caches.js",
        "test:configcache": "node test/test-config-cache.js",
        "test:cacheintegrity": "node test/test-compiler-cache-integrity.js",
        "test:processtimeout": "node test/test-process-timeout.js",
        "test:all": "npm run test:compiler && npm run test:run && npm run test:variables && npm run test:features && npm run test:integration && npm run test:deep && npm run test:autodetect && npm run test:qb64diagnostics && npm run test:qb64pe && npm run test:languagefeatures && npm run test:debugger && npm run test:workspace && npm run test:webview && npm run test:tutorial && npm run test:todo && npm run test:optimizations && npm run test:executables && npm run test:workersettings && npm run test:systemsettings && npm run test:hotpath && npm run test:configcache && npm run test:cacheintegrity && npm run test:processtimeout && npm run benchmark",
        "generate:snippets": "node scripts/generate-snippets.js",
        "package": "vsce package",
        "publish": "vsce publish",
        "test:workersettings": "node test/test-worker-settings.js",
        "test:qb64pe": "node test/test-qb64pe-support.js",
        "test:languagefeatures": "node test/test-language-features.js",
        "test:debugger": "node test/test-qb64-debugger.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "26.x",
        "@types/vscode": "^1.125.0",
        "eslint": "^10.7.0",
        "globals": "^17.7.0",
        "tinybench": "6.0.2"
    },
    "dependencies": {
        "defu": "^6.1.7",
        "flru": "^1.0.2",
        "mitt": "^3.0.1"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Formatters",
        "Linters"
    ],
    "keywords": [
        "qbasic",
        "quickbasic",
        "qb64",
        "basic",
        "retro",
        "compiler",
        "programming",
        "ide"
    ],
    "contributes": {
        "languages": [
            {
                "id": "qbasic",
                "aliases": [
                    "QBasic",
                    "QuickBASIC",
                    "QB64"
                ],
                "extensions": [
                    ".bas",
                    ".bi",
                    ".bm",
                    ".inc"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./assets/qb64.svg",
                    "dark": "./assets/qb64.svg"
                }
            }
        ],
        "commands": [
            {
                "command": "qbasic-nexus.configureSystem",
                "title": "QBasic Configure System ⚙️",
                "icon": "$(settings-gear)"
            },
            {
                "command": "qbasic-nexus.selectCompilerPath",
                "title": "QBasic Configure QB64 Path 🛤️",
                "icon": "$(tools)"
            },
            {
                "command": "qbasic-nexus.selectCompilerArgs",
                "title": "QBasic Configure QB64 Args 🧪",
                "icon": "$(symbol-parameter)"
            },
            {
                "command": "qbasic-nexus.compile",
                "title": "QBasic Compile 🔨",
                "icon": "$(tools)"
            },
            {
                "command": "qbasic-nexus.compileAndRun",
                "title": "QBasic Compile & Run 🌀",
                "icon": "$(play)"
            },
            {
                "command": "qbasic-nexus.runInCrt",
                "title": "QBasic Run in Retro CRT 📺",
                "icon": "$(device-desktop)"
            },
            {
                "command": "qbasic-nexus.startTutorial",
                "title": "QBasic Start Interactive Tutorial 🎮",
                "icon": "$(mortar-board)"
            },
            {
                "command": "qbasic-nexus.showCodeStats",
                "title": "QBasic Show Code Statistics 📊",
                "icon": "$(graph)"
            },
            {
                "command": "qbasic-nexus.removeLineNumbers",
                "title": "QBasic Remove Line Numbers 🔢",
                "icon": "$(list-ordered)"
            },
            {
                "command": "qbasic-nexus.renumberLines",
                "title": "QBasic Renumber Lines 🔄",
                "icon": "$(symbol-number)"
            },
            {
                "command": "qbasic-nexus.showAsciiChart",
                "title": "QBasic Show ASCII Chart 📋",
                "icon": "$(symbol-string)"
            },
            {
                "command": "qbasic-nexus.insertChrFromAsciiChart",
                "title": "QBasic Insert CHR$() at Cursor ✍️",
                "icon": "$(insert)"
            },
            {
                "command": "qbasic-nexus.refreshTodo",
                "title": "Refresh TODOs 🔄",
                "icon": "$(refresh)"
            },
            {
                "command": "qbasic-nexus.selectCompileWorkerResilience",
                "title": "QBasic Tune Compile Worker Resilience 🛡️",
                "icon": "$(pulse)"
            },
            {
                "command": "qbasic-nexus.selectLintWorkerResilience",
                "title": "QBasic Tune Lint Worker Resilience 🛡️",
                "icon": "$(pulse)"
            },
            {
                "command": "qbasic-nexus.selectEnableLinting",
                "title": "QBasic Configure Linting 🩺",
                "icon": "$(check)"
            },
            {
                "command": "qbasic-nexus.selectLintDelay",
                "title": "QBasic Set Lint Delay ⏱️",
                "icon": "$(history)"
            },
            {
                "command": "qbasic-nexus.selectAutoFormat",
                "title": "QBasic Configure Auto Format 💾",
                "icon": "$(paintcan)"
            },
            {
                "command": "qbasic-nexus.selectLineNumberSettings",
                "title": "QBasic Set Line Number Defaults 🔢",
                "icon": "$(symbol-number)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "qbasic-nexus.compile",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@1"
                },
                {
                    "command": "qbasic-nexus.compileAndRun",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@2"
                },
                {
                    "command": "qbasic-nexus.runInCrt",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@3"
                },
                {
                    "command": "qbasic-nexus.startTutorial",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@4"
                },
                {
                    "command": "qbasic-nexus.removeLineNumbers",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@1"
                },
                {
                    "command": "qbasic-nexus.renumberLines",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@2"
                },
                {
                    "command": "qbasic-nexus.showAsciiChart",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@3"
                },
                {
                    "command": "qbasic-nexus.insertChrFromAsciiChart",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@4"
                }
            ],
            "editor/title": [
                {
                    "command": "qbasic-nexus.compileAndRun",
                    "when": "resourceLangId == qbasic",
                    "group": "navigation"
                },
                {
                    "command": "qbasic-nexus.configureSystem",
                    "when": "resourceLangId == qbasic",
                    "group": "navigation@1"
                },
                {
                    "command": "qbasic-nexus.runInCrt",
                    "when": "resourceLangId == qbasic",
                    "group": "navigation@2"
                }
            ],
            "view/title": [
                {
                    "command": "qbasic-nexus.refreshTodo",
                    "when": "view == qbasic-todo",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "qbasic-nexus.compileAndRun",
                "key": "f5",
                "when": "resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.compile",
                "key": "ctrl+shift+b",
                "when": "resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.showCodeStats",
                "key": "ctrl+shift+i",
                "when": "resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.removeLineNumbers",
                "key": "ctrl+alt+r",
                "when": "editorTextFocus && resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.renumberLines",
                "key": "ctrl+alt+n",
                "when": "editorTextFocus && resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.showAsciiChart",
                "key": "ctrl+alt+a",
                "when": "resourceLangId == qbasic"
            }
        ],
        "grammars": [
            {
                "language": "qbasic",
                "scopeName": "source.qbasic",
                "path": "./syntaxes/qbasic.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "qbasic",
                "path": "./snippets/qbasic.json"
            }
        ],
        "configuration": {
            "title": "QBasic Nexus",
            "properties": {
                "qbasic-nexus.compilerPath": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "markdownDescription": "Full path to your **QB64** executable.\n\n**Examples:**\n- Windows: `C:\\QB64\\qb64.exe`\n- macOS: `/Applications/QB64/qb64`\n- Linux: `~/qb64/qb64`\n\nLeave empty for auto-detection.",
                    "scope": "machine"
                },
                "qbasic-nexus.compilerArgs": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Additional arguments for the QB64 compiler.\n\n**Examples:** `-w` (warnings), `-g` (debug)",
                    "scope": "resource"
                },
                "qbasic-nexus.compileWorkerMaxQueueSize": {
                    "type": "number",
                    "default": 64,
                    "minimum": 1,
                    "markdownDescription": "Maximum compile requests allowed in the shared worker queue before backpressure starts.\n\nWhen this limit is reached, new compile requests are resolved through the safe fallback path instead of growing memory usage.",
                    "scope": "resource"
                },
                "qbasic-nexus.compileWorkerRequestTimeoutMs": {
                    "type": "number",
                    "default": 30000,
                    "minimum": 0,
                    "markdownDescription": "Timeout in milliseconds for an in-flight compile worker request.\n\nSet to `0` to disable timeouts. When a request times out, the worker is recycled and the request falls back to the in-process compiler.",
                    "scope": "resource"
                },
                "qbasic-nexus.lintWorkerMaxQueueSize": {
                    "type": "number",
                    "default": 96,
                    "minimum": 1,
                    "markdownDescription": "Maximum lint requests allowed in the shared worker queue before backpressure starts.\n\nWhen this limit is reached, new lint requests are resolved through the safe fallback linter to keep the editor responsive.",
                    "scope": "resource"
                },
                "qbasic-nexus.lintWorkerRequestTimeoutMs": {
                    "type": "number",
                    "default": 15000,
                    "minimum": 0,
                    "markdownDescription": "Timeout in milliseconds for an in-flight lint worker request.\n\nSet to `0` to disable timeouts. When a request times out, the worker is recycled and diagnostics are computed via the fallback path.",
                    "scope": "resource"
                },
                "qbasic-nexus.externalBuildTimeoutMs": {
                    "type": "number",
                    "default": 300000,
                    "minimum": 0,
                    "markdownDescription": "Timeout in milliseconds for an external build process (the QB64 compiler or the native packager).\n\nIf the process does not finish in time it is terminated and the build fails with a timeout error, so a hung compiler never leaves Compile/Run stuck. Set to `0` to disable the guard.",
                    "scope": "resource"
                },
                "qbasic-nexus.enableLinting": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable real-time syntax checking and error highlighting.",
                    "scope": "resource"
                },
                "qbasic-nexus.lintDelay": {
                    "type": "number",
                    "default": 500,
                    "minimum": 100,
                    "maximum": 3000,
                    "markdownDescription": "Delay in milliseconds before linting after typing stops. Lower values = faster feedback but more CPU usage.",
                    "scope": "resource"
                },
                "qbasic-nexus.autoFormatOnSave": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Automatically format the document and auto-capitalize keywords when saving (mimicking classic QBasic IDE).",
                    "scope": "resource"
                },
                "qbasic-nexus.lineNumberStart": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "markdownDescription": "Starting line number used by **QBasic: Renumber Lines**.",
                    "scope": "resource"
                },
                "qbasic-nexus.lineNumberStep": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "markdownDescription": "Increment used by **QBasic: Renumber Lines**.",
                    "scope": "resource"
                },
                "qbasic-nexus.warnQB64PEOnly": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Warn when the program uses a keyword that only **QB64-PE** has (such as `_IIF` or `$EMBED`) while the compiler in use is the original QB64, which cannot build it.",
                    "scope": "resource"
                },
                "qbasic-nexus.codeLens.references": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show the number of call sites above every `SUB` and `FUNCTION`. Click it to list them.",
                    "scope": "resource"
                },
                "qbasic-nexus.inlayHints.parameterNames": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Show parameter names at calls to your `SUB`s / `FUNCTION`s and to built-in functions with two or more parameters. VS Code's `editor.inlayHints.enabled` also applies.",
                    "scope": "resource"
                },
                "qbasic-nexus.inlayHints.variableTypes": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Show the type implied by a variable's suffix (for example `count%` → `INTEGER`) at its first use.",
                    "scope": "resource"
                }
            }
        },
        "views": {
            "explorer": [
                {
                    "id": "qbasic-todo",
                    "name": "QBasic TODOs",
                    "icon": "assets/QBasicNexus.png"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "qb64",
                "required": [],
                "properties": {
                    "file": {
                        "type": "string",
                        "description": "The .bas file to build. Defaults to ${file} (the active editor). Relative paths resolve from the workspace folder."
                    },
                    "args": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Extra QB64 compiler arguments, added after qbasic-nexus.compilerArgs."
                    }
                }
            }
        ],
        "problemMatchers": [
            {
                "name": "qb64",
                "owner": "qb64",
                "source": "QB64",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+.(?:bas|bi|bm|inc)):(d+):s*(?:(error|warning)s*:s*)?(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        ],
        "breakpoints": [
            {
                "language": "qbasic"
            }
        ],
        "debuggers": [
            {
                "type": "qb64",
                "label": "QB64-PE",
                "languages": [
                    "qbasic"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "The .bas file to compile with $DEBUG and debug.",
                                "default": "${file}"
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Pause on the first line.",
                                "default": false
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "qb64",
                        "request": "launch",
                        "name": "Debug QB64-PE program",
                        "program": "${file}",
                        "stopOnEntry": false
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "QB64-PE: Debug program",
                        "description": "Compile the current file with QB64-PE and debug it",
                        "body": {
                            "type": "qb64",
                            "request": "launch",
                            "name": "Debug QB64-PE program",
                            "program": "^\"${file}\"",
                            "stopOnEntry": false
                        }
                    }
                ]
            }
        ]
    }
}
