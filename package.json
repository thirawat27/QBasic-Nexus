{
    "name": "qbasic-nexus",
    "displayName": "QBasic Nexus",
    "description": "QBasic, QB64 and QBNex 2.0 for VS Code: build, check, debug and run with the real compilers, live diagnostics through qb-lsp, a Retro CRT on the QBNex VM, IntelliSense, formatting and 150 interactive lessons.",
    "version": "2.0.0",
    "publisher": "Thirawat27",
    "author": "Thirawat27",
    "license": "MIT",
    "icon": "assets/QBasicNexus.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/thirawat27/QBasic-Nexus"
    },
    "bugs": {
        "url": "https://github.com/thirawat27/QBasic-Nexus/issues"
    },
    "homepage": "https://github.com/thirawat27/QBasic-Nexus#readme",
    "engines": {
        "node": ">=22.0.0",
        "vscode": "^1.125.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onLanguage:qbasic",
        "onView:qbasic-todo",
        "onDebugResolve:qbasic-nexus"
    ],
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "pretest": "npm run lint",
        "test": "node test/test-toolchain.js && node test/test-editor-features.js && node test/test-deep.js && node test/test-qb64-autodetect.js && node test/test-workspace-multi.js && node test/test-tutorial-manager.js && node test/test-todo-provider.js && node test/test-executable-utils.js && node test/test-system-settings.js && node test/test-hot-path-caches.js && node test/test-config-cache.js && node test/test-process-timeout.js",
        "benchmark": "node test/benchmark-editor.js",
        "generate:snippets": "node scripts/generate-snippets.js",
        "sync:qb-web": "node scripts/sync-qb-web.js",
        "package": "vsce package",
        "publish:vsce": "vsce publish",
        "publish:ovsx": "ovsx publish",
        "test:vscode": "node test/vscode/run.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "26.x",
        "@types/vscode": "1.125.0",
        "@vscode/test-electron": "3.1.0",
        "@vscode/vsce": "4.1.0",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "ovsx": "1.4.0",
        "tinybench": "6.2.3"
    },
    "dependencies": {
        "defu": "^6.1.7",
        "flru": "^1.0.2",
        "mitt": "^3.0.1",
        "vscode-languageclient": "11.0.0"
    },
    "categories": [
        "Programming Languages",
        "Debuggers",
        "Snippets",
        "Formatters",
        "Linters"
    ],
    "keywords": [
        "qbasic",
        "quickbasic",
        "qb64",
        "qb64pe",
        "qbnex",
        "basic",
        "retro",
        "compiler",
        "debugger",
        "ide"
    ],
    "contributes": {
        "languages": [
            {
                "id": "qbasic",
                "aliases": [
                    "QBasic",
                    "QuickBASIC",
                    "QB64",
                    "QBNex"
                ],
                "extensions": [
                    ".bas",
                    ".bi",
                    ".bm",
                    ".inc"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./assets/qb64.svg",
                    "dark": "./assets/qb64.svg"
                }
            }
        ],
        "commands": [
            {
                "command": "qbasic-nexus.configureSystem",
                "title": "QBasic: Configure System ⚙️",
                "icon": "$(settings-gear)"
            },
            {
                "command": "qbasic-nexus.showToolchainInfo",
                "title": "QBasic: Show Toolchain Info 🧰",
                "icon": "$(info)"
            },
            {
                "command": "qbasic-nexus.selectCompilerMode",
                "title": "QBasic: Select Compiler Mode 🧭",
                "icon": "$(compass)"
            },
            {
                "command": "qbasic-nexus.selectQBNexPath",
                "title": "QBasic: Configure QBNex Path 🛤️",
                "icon": "$(tools)"
            },
            {
                "command": "qbasic-nexus.selectCompilerPath",
                "title": "QBasic: Configure QB64 Path 🛤️",
                "icon": "$(tools)"
            },
            {
                "command": "qbasic-nexus.selectDiagnosticFlags",
                "title": "QBasic: Configure Diagnostics Flags 🩺",
                "icon": "$(checklist)"
            },
            {
                "command": "qbasic-nexus.selectCompilerArgs",
                "title": "QBasic: Configure Extra Compiler Args 🧪",
                "icon": "$(symbol-parameter)"
            },
            {
                "command": "qbasic-nexus.selectOutputDirectory",
                "title": "QBasic: Select Output Folder 📂",
                "icon": "$(folder-opened)"
            },
            {
                "command": "qbasic-nexus.selectFormatter",
                "title": "QBasic: Select Formatter 🖌️",
                "icon": "$(paintcan)"
            },
            {
                "command": "qbasic-nexus.restartLanguageServer",
                "title": "QBasic: Restart Language Server 🔁",
                "icon": "$(debug-restart)"
            },
            {
                "command": "qbasic-nexus.compile",
                "title": "QBasic: Compile 🔨",
                "icon": "$(tools)"
            },
            {
                "command": "qbasic-nexus.compileAndRun",
                "title": "QBasic: Compile & Run 🌀",
                "icon": "$(play)"
            },
            {
                "command": "qbasic-nexus.checkFile",
                "title": "QBasic: Check for Errors 🩺",
                "icon": "$(check-all)"
            },
            {
                "command": "qbasic-nexus.runInCrt",
                "title": "QBasic: Run in Retro CRT 📺",
                "icon": "$(device-desktop)"
            },
            {
                "command": "qbasic-nexus.startTutorial",
                "title": "QBasic: Start Interactive Tutorial 🎮",
                "icon": "$(mortar-board)"
            },
            {
                "command": "qbasic-nexus.showCodeStats",
                "title": "QBasic: Show Code Statistics 📊",
                "icon": "$(graph)"
            },
            {
                "command": "qbasic-nexus.removeLineNumbers",
                "title": "QBasic: Remove Line Numbers 🔢",
                "icon": "$(list-ordered)"
            },
            {
                "command": "qbasic-nexus.renumberLines",
                "title": "QBasic: Renumber Lines 🔄",
                "icon": "$(symbol-number)"
            },
            {
                "command": "qbasic-nexus.showAsciiChart",
                "title": "QBasic: Show ASCII Chart 📋",
                "icon": "$(symbol-string)"
            },
            {
                "command": "qbasic-nexus.insertChrFromAsciiChart",
                "title": "QBasic: Insert CHR$() at Cursor ✍️",
                "icon": "$(insert)"
            },
            {
                "command": "qbasic-nexus.refreshTodo",
                "title": "Refresh TODOs 🔄",
                "icon": "$(refresh)"
            },
            {
                "command": "qbasic-nexus.selectEnableLinting",
                "title": "QBasic: Configure Check On Save 🩺",
                "icon": "$(check)"
            },
            {
                "command": "qbasic-nexus.selectAutoFormat",
                "title": "QBasic: Configure Auto Format 💾",
                "icon": "$(paintcan)"
            },
            {
                "command": "qbasic-nexus.selectLineNumberSettings",
                "title": "QBasic: Set Line Number Defaults 🔢",
                "icon": "$(symbol-number)"
            },
            {
                "command": "qbasic-nexus.crtInput",
                "title": "QBasic CRT: Set INPUT Answers",
                "icon": "$(keyboard)"
            },
            {
                "command": "qbasic-nexus.crtRerun",
                "title": "QBasic CRT: Run Again",
                "icon": "$(debug-restart)"
            },
            {
                "command": "qbasic-nexus.crtStop",
                "title": "QBasic CRT: Stop Program",
                "icon": "$(debug-stop)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "qbasic-nexus.compile",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@1"
                },
                {
                    "command": "qbasic-nexus.compileAndRun",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@2"
                },
                {
                    "command": "qbasic-nexus.checkFile",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@3"
                },
                {
                    "command": "qbasic-nexus.runInCrt",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@4"
                },
                {
                    "command": "qbasic-nexus.startTutorial",
                    "when": "resourceLangId == qbasic",
                    "group": "1_qbasic@5"
                },
                {
                    "command": "qbasic-nexus.removeLineNumbers",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@1"
                },
                {
                    "command": "qbasic-nexus.renumberLines",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@2"
                },
                {
                    "command": "qbasic-nexus.showAsciiChart",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@3"
                },
                {
                    "command": "qbasic-nexus.insertChrFromAsciiChart",
                    "when": "resourceLangId == qbasic",
                    "group": "2_qbasicTools@4"
                }
            ],
            "editor/title": [
                {
                    "command": "qbasic-nexus.compileAndRun",
                    "when": "resourceLangId == qbasic",
                    "group": "navigation"
                },
                {
                    "command": "qbasic-nexus.configureSystem",
                    "when": "resourceLangId == qbasic",
                    "group": "navigation@1"
                },
                {
                    "command": "qbasic-nexus.runInCrt",
                    "when": "resourceLangId == qbasic",
                    "group": "navigation@2"
                },
                {
                    "command": "qbasic-nexus.crtInput",
                    "when": "activeWebviewPanelId == 'qbasicNexusCrt'",
                    "group": "navigation@10"
                },
                {
                    "command": "qbasic-nexus.crtRerun",
                    "when": "activeWebviewPanelId == 'qbasicNexusCrt'",
                    "group": "navigation@11"
                },
                {
                    "command": "qbasic-nexus.crtStop",
                    "when": "activeWebviewPanelId == 'qbasicNexusCrt'",
                    "group": "navigation@12"
                }
            ],
            "view/title": [
                {
                    "command": "qbasic-nexus.refreshTodo",
                    "when": "view == qbasic-todo",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "qbasic-nexus.crtInput",
                    "when": "activeWebviewPanelId == 'qbasicNexusCrt'"
                },
                {
                    "command": "qbasic-nexus.crtRerun",
                    "when": "activeWebviewPanelId == 'qbasicNexusCrt'"
                },
                {
                    "command": "qbasic-nexus.crtStop",
                    "when": "activeWebviewPanelId == 'qbasicNexusCrt'"
                }
            ]
        },
        "keybindings": [
            {
                "command": "qbasic-nexus.compileAndRun",
                "key": "f5",
                "when": "resourceLangId == qbasic && !inDebugMode"
            },
            {
                "command": "qbasic-nexus.runInCrt",
                "key": "shift+f5",
                "when": "resourceLangId == qbasic && !inDebugMode"
            },
            {
                "command": "qbasic-nexus.compile",
                "key": "ctrl+shift+b",
                "mac": "cmd+shift+b",
                "when": "resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.showCodeStats",
                "key": "ctrl+shift+i",
                "when": "resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.removeLineNumbers",
                "key": "ctrl+alt+r",
                "when": "editorTextFocus && resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.renumberLines",
                "key": "ctrl+alt+n",
                "when": "editorTextFocus && resourceLangId == qbasic"
            },
            {
                "command": "qbasic-nexus.showAsciiChart",
                "key": "ctrl+alt+a",
                "when": "resourceLangId == qbasic"
            }
        ],
        "grammars": [
            {
                "language": "qbasic",
                "scopeName": "source.qbasic",
                "path": "./syntaxes/qbasic.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "qbasic",
                "path": "./snippets/qbasic.json"
            }
        ],
        "configuration": {
            "title": "QBasic Nexus",
            "properties": {
                "qbasic-nexus.compilerMode": {
                    "type": "string",
                    "enum": [
                        "Auto",
                        "QBNex",
                        "QB64"
                    ],
                    "enumDescriptions": [
                        "QBNex 2.x when it is installed, otherwise QB64 / QB64-PE.",
                        "Build and check with QBNex (qb / qbnex).",
                        "Build and check with QB64 / QB64-PE."
                    ],
                    "default": "Auto",
                    "markdownDescription": "Compiler used to build, run and check programs. Settings from QBasic Nexus 1.x (`QB64 (Recommended)`, `Qbasic Nexus`) are converted automatically.",
                    "scope": "resource"
                },
                "qbasic-nexus.qbnexPath": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "markdownDescription": "Full path to the **QBNex** compiler (`qb` or `qbnex`).\n\nEmpty: auto-detect (`QBNEX_HOME`, `PATH`, `%LOCALAPPDATA%\\Programs\\QBNex`, `~/.local/bin`, `/opt/qbnex`). QBNex 2.0 or newer is recommended.",
                    "scope": "machine"
                },
                "qbasic-nexus.compilerPath": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "markdownDescription": "Full path to your **QB64 / QB64-PE** executable.\n\n**Examples:**\n- Windows: `C:\\QB64pe\\qb64pe.exe`\n- macOS: `/Applications/QB64pe/qb64pe`\n- Linux: `~/qb64pe/qb64pe`\n\nLeave empty for auto-detection.",
                    "scope": "machine"
                },
                "qbasic-nexus.showWarnings": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Pass `-w` so the compiler reports warnings (unused variables and more) in the Problems view.",
                    "scope": "resource"
                },
                "qbasic-nexus.warningsAsErrors": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Pass `-Werror` so warnings stop the build. **QBNex only**; QB64 has no such switch.",
                    "scope": "resource"
                },
                "qbasic-nexus.optionExplicit": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Pass `-e`: every variable must be declared, as with `OPTION _EXPLICIT` (QBNex and QB64-PE).",
                    "scope": "resource"
                },
                "qbasic-nexus.compilerArgs": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Extra arguments for the compiler, after the ones QBasic Nexus adds.\n\n**Examples:** `-k` (QBNex compact diagnostics), `-g` (QB64-PE debug info)",
                    "scope": "resource"
                },
                "qbasic-nexus.outputDirectory": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Folder for compiled programs. Empty: beside the source file. Relative paths resolve from the workspace folder; absolute and `~/...` paths are supported.",
                    "scope": "resource"
                },
                "qbasic-nexus.externalBuildTimeoutMs": {
                    "type": "number",
                    "default": 300000,
                    "minimum": 0,
                    "markdownDescription": "Timeout in milliseconds for a compiler run. A compiler that does not finish in time is stopped so Compile/Run never stays stuck. `0` disables the guard.",
                    "scope": "resource"
                },
                "qbasic-nexus.enableLinting": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Check each saved file with the active compiler and show its errors and warnings. QBNex runs `qb --emit-ir` (no native build); QB64 generates its C++ without compiling it (`-z`). While qb-lsp runs, QBNex diagnostics come from it as you type.",
                    "scope": "resource"
                },
                "qbasic-nexus.languageServer.enabled": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Start the QBNex language server (**qb-lsp**) for diagnostics as you type. Skipped when the official QBNex extension is installed (it runs qb-lsp itself) and in untrusted workspaces.",
                    "scope": "window"
                },
                "qbasic-nexus.languageServer.path": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path of `qb-lsp`. Empty: next to the QBNex compiler, else `qb-lsp` on `PATH`.",
                    "scope": "machine"
                },
                "qbasic-nexus.debugAdapterPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path of the QBNex debug adapter `qb-dap`. Empty: next to the QBNex compiler, else `qb-dap` on `PATH`.",
                    "scope": "machine"
                },
                "qbasic-nexus.formatter": {
                    "type": "string",
                    "enum": [
                        "builtin",
                        "qb-fmt"
                    ],
                    "enumDescriptions": [
                        "QBasic Nexus formatter: indentation and keyword case.",
                        "The QBNex formatter qb-fmt (falls back to the built-in one if qb-fmt cannot run)."
                    ],
                    "default": "builtin",
                    "markdownDescription": "Formatter for **Format Document** and format on save.",
                    "scope": "resource"
                },
                "qbasic-nexus.formatterPath": {
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Path of `qb-fmt`. Empty: next to the QBNex compiler, else `qb-fmt` on `PATH`.",
                    "scope": "machine"
                },
                "qbasic-nexus.autoFormatOnSave": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Format the document and capitalize keywords when saving (like the classic QBasic IDE). Skipped when `editor.formatOnSave` is on, which already formats.",
                    "scope": "resource"
                },
                "qbasic-nexus.lineNumberStart": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "markdownDescription": "Starting line number used by **QBasic: Renumber Lines**.",
                    "scope": "resource"
                },
                "qbasic-nexus.lineNumberStep": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "markdownDescription": "Increment used by **QBasic: Renumber Lines**.",
                    "scope": "resource"
                }
            }
        },
        "views": {
            "explorer": [
                {
                    "id": "qbasic-todo",
                    "name": "QBasic TODOs",
                    "icon": "assets/QBasicNexus.png"
                }
            ]
        },
        "breakpoints": [
            {
                "language": "qbasic"
            }
        ],
        "debuggers": [
            {
                "type": "qbasic-nexus",
                "label": "QBasic Nexus (QBNex)",
                "languages": [
                    "qbasic"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "The .bas file to debug.",
                                "default": "${file}"
                            },
                            "qir": {
                                "type": "string",
                                "description": "Run this QIR file instead of compiling the program."
                            },
                            "compiler": {
                                "type": "string",
                                "description": "QBNex compiler used to produce QIR (default: the detected or configured QBNex)."
                            },
                            "cwd": {
                                "type": "string",
                                "description": "Working directory of the program (default: the program's folder)."
                            },
                            "stopOnEntry": {
                                "type": "boolean",
                                "description": "Stop at the first statement.",
                                "default": false
                            },
                            "input": {
                                "type": "string",
                                "description": "File whose contents the program reads as standard input (INPUT, LINE INPUT)."
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "qbasic-nexus",
                        "request": "launch",
                        "name": "Debug QBasic program",
                        "program": "${file}",
                        "stopOnEntry": false
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "QBasic Nexus: Debug program (QBNex)",
                        "description": "Debug a .bas file on the QBNex VM with breakpoints and variables",
                        "body": {
                            "type": "qbasic-nexus",
                            "request": "launch",
                            "name": "Debug QBasic program",
                            "program": "^\"\\${file}\"",
                            "stopOnEntry": false
                        }
                    }
                ]
            }
        ],
        "configurationDefaults": {
            "[qbasic]": {
                "editor.defaultFormatter": "Thirawat27.qbasic-nexus"
            }
        }
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In an untrusted workspace the compiler, language server, debugger and formatter paths and the compiler arguments come only from your user settings, and the language server does not start.",
            "restrictedConfigurations": [
                "qbasic-nexus.compilerPath",
                "qbasic-nexus.qbnexPath",
                "qbasic-nexus.compilerArgs",
                "qbasic-nexus.languageServer.path",
                "qbasic-nexus.debugAdapterPath",
                "qbasic-nexus.formatterPath"
            ]
        }
    }
}
